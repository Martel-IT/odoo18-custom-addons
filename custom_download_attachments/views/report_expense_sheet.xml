<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         Custom Martel expense sheet report template
         Renders: title band (ID + approval date), header fields,
                  expense lines table, total row, signature line
    ========================================================= -->
    <template id="report_expense_sheet_martel" name="Expense Sheet Report (Martel)">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <!-- Same Martel-blue accents as the timesheet PDF
                         (timesheets_by_employee/report/timesheet_templates.xml). -->
                    <style>
                        .o_exp_report .exp-title-row {
                            border-bottom: 2px solid #1f3a5f;
                            padding: 4px 0; margin-bottom: 14px;
                        }
                        .o_exp_report .exp-title {
                            font-size: 20px; font-weight: 500;
                            color: #1f3a5f; margin: 0;
                        }
                        .o_exp_report .exp-title .exp-id { font-size: 15px; margin-left: 8px; }
                        .o_exp_report .exp-approval {
                            font-size: 12px; color: #1f3a5f;
                            text-align: right; padding-top: 10px;
                        }
                        .o_exp_report .exp-meta { font-size: 12px; margin-bottom: 14px; }
                        .o_exp_report .exp-meta strong { color: #1f3a5f; }
                        .o_exp_report .exp-meta p { margin: 2px 0 0 0; }

                        .o_exp_report table.table {
                            font-size: 11px;
                            border-color: #c5d2e0;
                        }
                        .o_exp_report table.table thead th {
                            background: #eef3f8; color: #1f3a5f;
                            font-weight: 600;
                            border-bottom: 1px solid #c5d2e0;
                        }
                        .o_exp_report table.exp-lines tbody tr:nth-child(even) td {
                            background: #f7f9fc;
                        }
                        .o_exp_report .exp-total td {
                            background: #eef3f8; color: #1f3a5f;
                            font-weight: 600;
                            border-top: 1px solid #c5d2e0;
                        }
                        .o_exp_report .exp-signoff {
                            margin-top: 18px; padding-top: 10px;
                            border-top: 1px solid #c5d2e0;
                            font-size: 12px;
                            page-break-inside: avoid;
                        }
                        .o_exp_report .exp-signoff strong { color: #1f3a5f; }
                    </style>
                    <div class="page o_exp_report">

                        <!-- Title band: report ID left, approval date right -->
                        <div class="row exp-title-row">
                            <div class="col-8">
                                <h2 class="exp-title">
                                    Expense Report
                                    <span class="exp-id">(ID: <span t-esc="o.id"/>)</span>
                                </h2>
                            </div>
                            <div class="col-4 exp-approval">
                                <strong>Approval Date:</strong>
                                <t t-if="o.date_approve">
                                    <span t-field="o.date_approve"/>
                                </t>
                                <t t-else="">—</t>
                            </div>
                        </div>

                        <!-- Header fields -->
                        <div class="row exp-meta">
                            <div class="col-3">
                                <strong>Employee:</strong>
                                <p t-field="o.employee_id.name"/>
                            </div>
                            <div class="col-4">
                                <strong>Description:</strong>
                                <p t-field="o.name"/>
                            </div>
                            <div class="col-2">
                                <strong>Validated By:</strong>
                                <p t-field="o.user_id"/>
                            </div>
                            <div class="col-3">
                                <strong>Payment By:</strong>
                                <p t-field="o.payment_mode"/>
                            </div>
                        </div>

                        <!-- Expense lines table -->
                        <table class="table table-sm exp-lines">
                            <thead>
                                <tr>
                                    <th class="col-2">Date</th>
                                    <th class="col-3">Description</th>
                                    <th class="col-2">Project</th>
                                    <th class="col-1 text-end">Unit Price</th>
                                    <th class="col-1 text-center">Qty</th>
                                    <th class="col-1 text-end">Total</th>
                                    <th t-if="o.is_multiple_currency" class="col-2 text-end">
                                        Total (Company Currency)
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.expense_line_ids" t-as="line">
                                    <td class="col-2">
                                        <span t-field="line.date"/>
                                    </td>
                                    <td class="col-3">
                                        <span t-field="line.name"/>
                                    </td>
                                    <td class="col-2">
                                        <!-- analytic_distribution is a JSON dict {account_id: percentage} -->
                                        <t t-foreach="line.analytic_distribution or {}" t-as="dist_id">
                                            <span t-esc="line.env['account.analytic.account'].browse(int(dist_id)).name"/>
                                        </t>
                                    </td>
                                    <td class="col-1 text-end">
                                        <span t-field="line.price_unit"/>
                                    </td>
                                    <td class="col-1 text-center">
                                        <span t-field="line.quantity"/>
                                    </td>
                                    <!-- total in expense currency -->
                                    <td class="col-1 text-end">
                                        <span t-field="line.total_amount_currency"
                                              t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
                                    </td>
                                    <!-- total in company currency (multi-currency only) -->
                                    <td t-if="o.is_multiple_currency" class="col-2 text-end">
                                        <span t-field="line.total_amount"
                                              t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Grand total -->
                        <div class="row justify-content-end">
                            <div class="col-4">
                                <table class="table table-sm">
                                    <tr class="exp-total">
                                        <td><strong>Total</strong></td>
                                        <td class="text-end">
                                            <span t-field="o.total_amount"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="exp-signoff">
                            <p>Certified honest and conform,<br/>(Date and signature).</p>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Report action wired to the template above -->
    <record id="action_report_expense_sheet_martel" model="ir.actions.report">
        <field name="name">Expense Sheet (Martel)</field>
        <field name="model">hr.expense.sheet</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_download_attachments.report_expense_sheet_martel</field>
        <field name="report_file">custom_download_attachments.report_expense_sheet_martel</field>
        <!-- Same filename the old merged-PDF flow produced -->
        <field name="print_report_name">'Expense_Report_%s_%s' % ((object.employee_id.name or 'employee').replace('/', '-'), object.id)</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

</odoo>
